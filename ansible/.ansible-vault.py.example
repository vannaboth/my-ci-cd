#!/usr/bin/env python3
"""Ansible vault password client.

Print the vault password to stdout. Ansible calls this when it needs the
password (configured in ansible.cfg as vault_password_file).

Copy to /etc/ansible/.ansible-vault.py and make it executable:

    sudo cp ansible/.ansible-vault.py.example /etc/ansible/.ansible-vault.py
    sudo chmod 700 /etc/ansible/.ansible-vault.py

Choose ONE method below: read from a file, or an env var.
"""

import os

VAULT_PASS_FILE = "/etc/ansible/.vault_pass"
VAULT_PASS_ENV = "ANSIBLE_VAULT_PASS"


def get_password():
    # Option A: read from a root-only file
    if os.path.exists(VAULT_PASS_FILE):
        with open(VAULT_PASS_FILE) as f:
            return f.read().rstrip("\n")

    # Option B: environment variable
    env = os.environ.get(VAULT_PASS_ENV)
    if env:
        return env

    raise SystemExit("vault password not found (missing %s or $%s)"
                     % (VAULT_PASS_FILE, VAULT_PASS_ENV))


if __name__ == "__main__":
    print(get_password())
