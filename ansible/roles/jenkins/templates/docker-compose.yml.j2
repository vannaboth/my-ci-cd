---
services:
  jenkins:
    build: .
    image: my-cicd/jenkins:latest
    container_name: jenkins
    ports:
      - "8080:8080"
      - "50000:50000"
    volumes:
      - jenkins_home:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
      - /etc/jenkins/ssh/app-key.pem:/var/jenkins_home/.ssh/app-key.pem
    env_file: .env
    restart: unless-stopped

volumes:
  jenkins_home:
